# Copy to .env and fill in. Never commit .env.

# PostgreSQL (SQLAlchemy URL). Supabase/Render give you this string.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/esports

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000

# Provider credentials: server side only, optional, NOT used in v1.0
# (no endpoint is verified yet; see docs/data_sources.md)
RIOT_API_KEY=
GRID_API_KEY=
PANDASCORE_API_KEY=

# Optional overrides
# DATA_DIR=./data
# MODELS_DIR=./machine_learning/models/artifacts
# ALLOW_CSV_EXPORT=true
# MAX_EXPORT_ROWS=5000
# RATE_LIMIT_PER_MINUTE=120

# Frontend (public, not a secret): URL of the backend API
NEXT_PUBLIC_API_URL=http://localhost:8000
